@model ClaimCar.Web.Models.PolicyDetailViewModel
@{ Layout=null; var p=Model.Policy; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Thông tin HĐBH</title><link rel="stylesheet" href="@Url.Content("~/Content/site.css")"/><link rel="stylesheet" href="@Url.Content("~/Content/policy-popup.css")"/></head><body class="policy-popup-body">
<div class="policy-popup-header"><div><h2>Thông tin hợp đồng bảo hiểm</h2><div>Hồ sơ: <strong>@Model.Claim.ClaimNumber</strong> · Hợp đồng: <strong>@Model.Claim.PolicyNumber</strong></div></div>@if(p!=null){<span class="policy-status">@p.Status</span>}</div>
@if(p==null){<div class="notice notice-error">Không tìm thấy hợp đồng trong dữ liệu cấp đơn.</div>}
else{
<div class="policy-segments" role="tablist"><button class="policy-segment active" type="button" data-panel="summary">Tổng quan</button><button class="policy-segment" type="button" data-panel="owner">Chủ xe</button><button class="policy-segment" type="button" data-panel="vehicle">Phương tiện</button><button class="policy-segment" type="button" data-panel="coverage">Quyền lợi &amp; Phí</button></div>
<div id="summary" class="policy-panel active"><div class="policy-kpis"><div><span>Số hợp đồng</span><strong>@p.PolicyNumber</strong></div><div><span>Số đơn / GCN</span><strong>@p.CertificateNumber</strong></div><div><span>Ngày cấp</span><strong>@p.IssueDate.ToString("dd/MM/yyyy")</strong></div><div><span>Hiệu lực</span><strong>@p.EffectiveFrom.ToString("dd/MM/yyyy") - @p.EffectiveTo.ToString("dd/MM/yyyy")</strong></div></div><div class="policy-info-grid"><div><span>Đơn vị cấp</span><strong>@p.UnitCode</strong></div><div><span>Kênh khai thác</span><strong>@p.DistributionChannel</strong></div><div><span>Cán bộ cấp đơn</span><strong>@p.IssuedBy</strong></div><div><span>Trạng thái</span><strong>@p.Status</strong></div><div class="wide"><span>Ghi chú</span><strong>@p.Notes</strong></div></div></div>
<div id="owner" class="policy-panel"><div class="policy-info-grid"><div><span>Mã khách hàng</span><strong>@p.CustomerCode</strong></div><div><span>Tên chủ xe</span><strong>@p.OwnerName</strong></div><div><span>Loại khách hàng</span><strong>@p.CustomerType</strong></div><div><span>CCCD / MST</span><strong>@p.IdentityNumber</strong></div><div><span>Điện thoại</span><strong>@p.Phone</strong></div><div><span>Email</span><strong>@p.Email</strong></div><div class="wide"><span>Địa chỉ</span><strong>@p.Address</strong></div></div></div>
<div id="vehicle" class="policy-panel"><div class="policy-info-grid"><div><span>Biển số</span><strong>@p.LicensePlate</strong></div><div><span>Nhãn hiệu</span><strong>@p.Brand</strong></div><div><span>Dòng xe</span><strong>@p.Model</strong></div><div><span>Năm sản xuất</span><strong>@p.ManufactureYear</strong></div><div><span>Số khung</span><strong>@p.ChassisNumber</strong></div><div><span>Số máy</span><strong>@p.EngineNumber</strong></div><div><span>Số chỗ</span><strong>@p.Seats</strong></div><div><span>Mục đích sử dụng</span><strong>@p.UsagePurpose</strong></div></div></div>
<div id="coverage" class="policy-panel"><div class="policy-kpis"><div><span>Giá trị xe</span><strong>@p.VehicleValue.ToString("N0") @p.Currency</strong></div><div><span>Số tiền bảo hiểm</span><strong>@p.InsuredAmount.ToString("N0") @p.Currency</strong></div><div><span>Tổng phí</span><strong>@p.TotalPremium.ToString("N0") @p.Currency</strong></div><div><span>Mức khấu trừ</span><strong>@p.Deductible.ToString("N0") @p.Currency</strong></div></div><div class="policy-info-grid"><div><span>Phí trước thuế</span><strong>@p.PremiumBeforeTax.ToString("N0") @p.Currency</strong></div><div><span>Thuế GTGT</span><strong>@p.VatAmount.ToString("N0") @p.Currency</strong></div><div class="wide"><span>Phạm vi bảo hiểm</span><strong>@p.CoverageScope</strong></div></div></div>
}
<script>var buttons=document.querySelectorAll('.policy-segment');for(var i=0;i<buttons.length;i++){buttons[i].onclick=function(){var panels=document.querySelectorAll('.policy-panel');for(var j=0;j<panels.length;j++)panels[j].className='policy-panel';for(var k=0;k<buttons.length;k++)buttons[k].className='policy-segment';document.getElementById(this.getAttribute('data-panel')).className='policy-panel active';this.className='policy-segment active';};}</script>
</body></html>
