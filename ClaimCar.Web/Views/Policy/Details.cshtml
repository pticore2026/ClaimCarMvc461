@model ClaimCar.Web.Models.PolicyDetailViewModel
@{ ViewBag.Title="Thông tin hợp đồng bảo hiểm"; var p=Model.Policy; }
<div class="toolbar"><div><h1>Thông tin hợp đồng bảo hiểm</h1><div class="muted">Thông tin cấp đơn đối chiếu cho hồ sơ <strong>@Model.Claim.ClaimNumber</strong>.</div></div><a class="btn btn-secondary" href="@Url.Action("Index","Claim")">Danh sách hồ sơ</a></div>
<div class="tabs"><a class="tab" href="@Url.Action("Edit","Claim",new{id=Model.Claim.Id})">Thông tin chung</a><a class="tab active" href="#">Thông tin HĐBH</a><a class="tab" href="@Url.Action("Edit","LossPayment",new{claimId=Model.Claim.Id})">Tổn thất / Chi trả</a><a class="tab" href="@Url.Action("Edit","Quote",new{claimId=Model.Claim.Id})">Báo giá</a></div>
@if(p==null){<div class="notice notice-error">Không tìm thấy hợp đồng <strong>@Model.Claim.PolicyNumber</strong> trong dữ liệu cấp đơn.</div>}
else{
<div class="card">
<div class="section-title"><span>Thông tin đơn bảo hiểm</span></div>
<div class="form-grid"><div class="form-group"><label>Số hợp đồng</label><input class="form-control readonly" value="@p.PolicyNumber" readonly /></div><div class="form-group"><label>Số đơn / GCN</label><input class="form-control readonly" value="@p.CertificateNumber" readonly /></div><div class="form-group"><label>Ngày cấp đơn</label><input class="form-control readonly" value="@p.IssueDate.ToString("dd/MM/yyyy")" readonly /></div><div class="form-group"><label>Trạng thái</label><input class="form-control readonly" value="@p.Status" readonly /></div></div>
<div class="section-title"><span>Chủ xe / Người được bảo hiểm</span></div>
<div class="form-grid"><div class="form-group"><label>Mã khách hàng</label><input class="form-control readonly" value="@p.CustomerCode" readonly /></div><div class="form-group"><label>Tên chủ xe</label><input class="form-control readonly" value="@p.OwnerName" readonly /></div><div class="form-group"><label>Loại khách hàng</label><input class="form-control readonly" value="@p.CustomerType" readonly /></div><div class="form-group"><label>CCCD / MST</label><input class="form-control readonly" value="@p.IdentityNumber" readonly /></div><div class="form-group"><label>Điện thoại</label><input class="form-control readonly" value="@p.Phone" readonly /></div><div class="form-group"><label>Email</label><input class="form-control readonly" value="@p.Email" readonly /></div><div class="form-group" style="grid-column:span 2"><label>Địa chỉ</label><input class="form-control readonly" value="@p.Address" readonly /></div></div>
<div class="section-title"><span>Thông tin xe</span></div>
<div class="form-grid"><div class="form-group"><label>Biển số</label><input class="form-control readonly" value="@p.LicensePlate" readonly /></div><div class="form-group"><label>Số khung</label><input class="form-control readonly" value="@p.ChassisNumber" readonly /></div><div class="form-group"><label>Số máy</label><input class="form-control readonly" value="@p.EngineNumber" readonly /></div><div class="form-group"><label>Hãng / Dòng xe</label><input class="form-control readonly" value="@p.Brand @p.Model" readonly /></div><div class="form-group"><label>Năm sản xuất</label><input class="form-control readonly" value="@p.ManufactureYear" readonly /></div><div class="form-group"><label>Số chỗ</label><input class="form-control readonly" value="@p.Seats" readonly /></div><div class="form-group" style="grid-column:span 2"><label>Mục đích sử dụng</label><input class="form-control readonly" value="@p.UsagePurpose" readonly /></div></div>
<div class="section-title"><span>Hiệu lực và quyền lợi bảo hiểm</span></div>
<div class="form-grid"><div class="form-group"><label>Hiệu lực từ</label><input class="form-control readonly" value="@p.EffectiveFrom.ToString("dd/MM/yyyy")" readonly /></div><div class="form-group"><label>Hiệu lực đến</label><input class="form-control readonly" value="@p.EffectiveTo.ToString("dd/MM/yyyy")" readonly /></div><div class="form-group"><label>Giá trị xe</label><input class="form-control readonly right" value="@p.VehicleValue.ToString("N0") @p.Currency" readonly /></div><div class="form-group"><label>Số tiền bảo hiểm</label><input class="form-control readonly right" value="@p.InsuredAmount.ToString("N0") @p.Currency" readonly /></div><div class="form-group" style="grid-column:span 4"><label>Phạm vi bảo hiểm</label><input class="form-control readonly" value="@p.CoverageScope" readonly /></div></div>
<div class="section-title"><span>Phí và khai thác</span></div>
<div class="form-grid"><div class="form-group"><label>Phí trước thuế</label><input class="form-control readonly right" value="@p.PremiumBeforeTax.ToString("N0")" readonly /></div><div class="form-group"><label>Thuế GTGT</label><input class="form-control readonly right" value="@p.VatAmount.ToString("N0")" readonly /></div><div class="form-group"><label>Tổng phí</label><input class="form-control readonly right" value="@p.TotalPremium.ToString("N0")" readonly /></div><div class="form-group"><label>Mức khấu trừ</label><input class="form-control readonly right" value="@p.Deductible.ToString("N0")" readonly /></div><div class="form-group"><label>Kênh khai thác</label><input class="form-control readonly" value="@p.DistributionChannel" readonly /></div><div class="form-group"><label>Cán bộ cấp đơn</label><input class="form-control readonly" value="@p.IssuedBy" readonly /></div></div>
</div>}
