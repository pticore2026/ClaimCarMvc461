@model ClaimCar.Web.Models.LossPaymentViewModel
@{ ViewBag.Title="Tổn thất / Chi trả"; var claim=(ClaimCar.Web.Models.Claim)ViewBag.Claim; var eventCodes=new[]{"Không sự kiện 2025","Bão số 12 - Fengshen","Bão số 11 - Matmo","Bão số 10 - Bualai","Bão số 2 - Yagi"}; }
<div class="toolbar"><div><h1>Tổn thất / Chi trả</h1><div class="muted">Xác định phạm vi bảo hiểm, trách nhiệm, gara và luồng thanh toán.</div></div><a class="btn btn-secondary" href="@Url.Action("Index","Claim")">Danh sách hồ sơ</a></div>
<div class="tabs"><a class="tab" href="@Url.Action("Edit","Claim",new{id=Model.ClaimId})">Thông tin chung</a><a class="tab active" href="#">Tổn thất / Chi trả</a><a class="tab" href="@Url.Action("Edit","Quote",new{claimId=Model.ClaimId})">Báo giá</a></div>
<div class="card">
@using(Html.BeginForm("Edit","LossPayment",FormMethod.Post,new{accept_charset="utf-8"})){
@Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ClaimId)
if(!ViewData.ModelState.IsValid){<div class="notice notice-error">@Html.ValidationSummary(false)</div>}
<table class="grid-table coverage-table"><thead><tr><th><span>LOẠI HÌNH</span><button type="button" class="coverage-add-trigger" aria-label="Thêm loại hình" title="Thêm loại hình">+</button></th><th>N.TỆ</th><th>TIỀN BẢO HIỂM</th><th>%TT</th><th>TIỀN TT</th><th>KHẤU TRỪ</th><th>TIỀN</th><th>THUẾ</th><th>THAO TÁC</th></tr></thead><tbody class="coverage-rows">@for(var i=0;i<Model.Coverages.Count;i++){<tr><td>@Html.HiddenFor(x=>x.Coverages[i].Id)<span class="coverage-code">@Model.Coverages[i].CoverageCode</span>@Html.HiddenFor(x=>x.Coverages[i].CoverageCode)</td><td>@Html.TextBoxFor(x=>x.Coverages[i].Currency,new{@class="form-control coverage-line-input",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].InsuranceAmount,new{@class="form-control right coverage-line-input",type="number",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].LossPercent,new{@class="form-control right coverage-line-input",type="number",step="0.01",min="0",max="100",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].LossAmount,new{@class="form-control right coverage-line-input",type="number",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].Deductible,new{@class="form-control right coverage-line-input",type="number",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].CompensationAmount,new{@class="form-control right coverage-line-input",type="number",@readonly="readonly"})</td><td>@Html.TextBoxFor(x=>x.Coverages[i].TaxAmount,new{@class="form-control right coverage-line-input",type="number",@readonly="readonly"})</td><td class="coverage-actions"><button type="button" class="coverage-edit" aria-label="Chỉnh sửa @Model.Coverages[i].CoverageCode" title="Chỉnh sửa">✎</button><button type="button" class="coverage-delete" aria-label="Xóa @Model.Coverages[i].CoverageCode" title="Xóa">🗑</button></td></tr>}</tbody></table>
<div style="height:12px"></div>
<div class="six-col">
<div class="form-group code-picker-field">
    <label class="required">Nguyên nhân</label>
    @Html.HiddenFor(x=>x.CauseCode)
    <button type="button" id="CauseCodeDisplay" class="form-control code-picker-trigger" data-picker="cause" data-field="CauseCode" data-title="Lựa chọn mã nguyên nhân" data-placeholder="-- Chọn mã nguyên nhân --">@(string.IsNullOrWhiteSpace(Model.CauseCode)?"-- Chọn mã nguyên nhân --":Model.CauseCode)</button>
</div>
<div class="form-group code-picker-field">
    <label>Mã hành vi</label>
    @Html.HiddenFor(x=>x.BehaviorCode)
    <button type="button" id="BehaviorCodeDisplay" class="form-control code-picker-trigger" data-picker="behavior" data-field="BehaviorCode" data-title="Lựa chọn mã hành vi" data-placeholder="-- Chọn mã hành vi --">@(string.IsNullOrWhiteSpace(Model.BehaviorCode)?"-- Chọn mã hành vi --":Model.BehaviorCode)</button>
</div>
<div class="form-group code-picker-field">
    <label class="required">Khu vực</label>
    @Html.HiddenFor(x=>x.AreaCode)
    <button type="button" id="AreaCodeDisplay" class="form-control code-picker-trigger" data-picker="area" data-field="AreaCode" data-title="Lựa chọn khu vực" data-placeholder="-- Chọn khu vực --">@(string.IsNullOrWhiteSpace(Model.AreaCode)?"-- Chọn khu vực --":Model.AreaCode)</button>
</div><div class="form-group"><label class="required">Sự kiện</label>@Html.DropDownListFor(x=>x.EventCode,new SelectList(eventCodes,Model.EventCode),"-- Chọn sự kiện --",new{@class="form-control"})</div><div class="form-group"><label>CVăn TBTN-YCB</label>@Html.TextBoxFor(x=>x.TbtnYcbReference,new{@class="form-control"})</div></div>
<div class="three-col"><div class="form-group"><label class="required">Diễn biến tai nạn</label>@Html.TextAreaFor(x=>x.AccidentDescription,new{@class="form-control textarea"})</div><div class="form-group"><label class="required">Mô tả nguyên nhân</label>@Html.TextAreaFor(x=>x.CauseDescription,new{@class="form-control textarea"})</div><div class="form-group"><label class="required">Mô tả hậu quả</label>@Html.TextAreaFor(x=>x.ConsequenceDescription,new{@class="form-control textarea"})</div></div>
<div style="height:12px"></div><div class="six-col"><div class="form-group"><label>Mã Gara sửa chữa</label>@Html.HiddenFor(x=>x.GarageCode)<button type="button" id="GarageCodeDisplay" class="form-control code-picker-trigger garage-picker-trigger">@(string.IsNullOrWhiteSpace(Model.GarageCode)?"-- Chọn Gara --":Model.GarageCode)</button></div><div class="form-group" style="grid-column:span 3"><label>Tên Gara</label>@Html.TextBoxFor(x=>x.GarageName,new{@class="form-control readonly",@readonly="readonly"})</div><div class="form-group"><label>Phone Gara</label>@Html.TextBoxFor(x=>x.GaragePhone,new{@class="form-control"})</div><div class="form-group"><label>Email Gara</label>@Html.TextBoxFor(x=>x.GarageEmail,new{@class="form-control"})</div><div class="form-group"><label>Thanh toán qua Gara</label><select class="form-control" name="PayThroughGarage"><option value="true" @(Model.PayThroughGarage?"selected":"")>Có</option><option value="false" @(!Model.PayThroughGarage?"selected":"")>Không</option></select></div><div class="form-group"><label>Đòi quỹ hiệp hội</label><select class="form-control" name="AssociationFund"><option value="false" @(!Model.AssociationFund?"selected":"")>Không</option><option value="true" @(Model.AssociationFund?"selected":"")>Có</option></select></div></div>
<div class="two-col"><div><div class="section-title"><span>ĐỐI TƯỢNG HƯỞNG KHÁC</span></div><table class="grid-table beneficiary-table"><thead><tr><th><span>MÃ</span><button type="button" class="beneficiary-add-trigger" aria-label="Thêm đối tượng hưởng khác" title="Thêm đối tượng hưởng khác">+</button></th><th>ĐỐI TƯỢNG HƯỞNG KHÁC</th><th>N.TỆ</th><th>TIỀN</th></tr></thead><tbody class="beneficiary-rows">@for(var i=0;i<Model.OtherBeneficiaries.Count;i++){<tr><td>@Html.HiddenFor(x=>x.OtherBeneficiaries[i].Id)@Html.TextBoxFor(x=>x.OtherBeneficiaries[i].Code,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.OtherBeneficiaries[i].Name,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.OtherBeneficiaries[i].Currency,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.OtherBeneficiaries[i].Amount,new{@class="form-control right",type="number",min="0"})</td></tr>}</tbody></table></div><div><div class="section-title"><span>PHẢI ĐÒI NGƯỜI THỨ 3</span></div><table class="grid-table"><thead><tr><th>ĐỐI TƯỢNG</th><th>N.TỆ</th><th>TIỀN BẢO HIỂM</th></tr></thead><tbody>@if(Model.ThirdParties.Count==0){<tr><td colspan="3" class="muted center">Chưa có dữ liệu</td></tr>}@for(var i=0;i<Model.ThirdParties.Count;i++){<tr><td>@Html.TextBoxFor(x=>x.ThirdParties[i].Name,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.ThirdParties[i].Currency,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.ThirdParties[i].Amount,new{@class="form-control right"})</td></tr>}</tbody></table></div></div>
<div class="footer-actions"><button class="btn btn-secondary js-previous-tab" type="button">Quay lại</button><button class="btn js-next-tab" type="button">Tiếp theo</button></div>}
</div>
