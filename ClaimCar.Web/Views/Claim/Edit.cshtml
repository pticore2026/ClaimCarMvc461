@model ClaimCar.Web.Models.Claim
@{ ViewBag.Title=Model.Id==0?"Tạo hồ sơ":"Thông tin chung"; var isNew=Model.Id==0; }
<div class="toolbar"><div><h1>@(isNew?"Tạo hồ sơ bồi thường":"Chi tiết hồ sơ")</h1></div><a class="btn btn-secondary" href="@Url.Action("Index")">Danh sách hồ sơ</a></div>
@if(!isNew){<div class="tabs"><a class="tab active" href="@Url.Action("Edit","Claim",new{id=Model.Id})">Thông tin chung</a><a class="tab" href="@Url.Action("Edit","LossPayment",new{claimId=Model.Id})">Tổn thất / Chi trả</a><a class="tab" href="@Url.Action("Edit","Quote",new{claimId=Model.Id})">Báo giá</a></div>}
<div class="card">
@using(Html.BeginForm("Edit","Claim",FormMethod.Post,new{accept_charset="utf-8"})){
@Html.AntiForgeryToken() @Html.HiddenFor(x=>x.Id)
if(!ViewData.ModelState.IsValid){<div class="notice notice-error">@Html.ValidationSummary(false)</div>}
<div class="form-grid">
<div class="form-group"><label class="required">Đơn vị Quản lý</label>@Html.HiddenFor(x=>x.ManagementUnitCode)@Html.TextBoxFor(x=>x.ManagementUnitName,new{@class="form-control readonly"})</div>
<div class="form-group"><label class="required">Khu vực quản lý</label>@Html.HiddenFor(x=>x.ManagementAreaCode)@Html.TextBoxFor(x=>x.ManagementAreaName,new{@class="form-control"})</div>
<div class="form-group"><label class="required">Biển số</label>@Html.TextBoxFor(x=>x.LicensePlate,new{@class="form-control readonly"})</div>
<div class="form-group"><label class="required">Ngày nhập</label><input class="form-control readonly" type="date" name="EntryDate" value="@Model.EntryDate.ToString("yyyy-MM-dd")"/></div>
<div class="form-group"><label>Ngày nhập Call</label><input class="form-control readonly" type="date" name="CallEntryDate" value="@(Model.CallEntryDate.HasValue?Model.CallEntryDate.Value.ToString("yyyy-MM-dd"):"")"/></div>
<div class="form-group"><label class="required">Số hợp đồng</label>@Html.TextBoxFor(x=>x.PolicyNumber,new{@class="form-control readonly"})</div>
<div class="form-group"><label class="required">Tình trạng hồ sơ</label><select class="form-control readonly" name="Status">@foreach(var s in new[]{"Mới tiếp nhận","Đang giám định","Đã bảo lãnh","Đã trình duyệt","Đã duyệt","Đã chi trả","Từ chối"}){<option value="@s" @(Model.Status==s?"selected":"")>@s</option>}</select></div>
<div class="form-group"><label>Ngày quyết định</label><input class="form-control" type="date" name="DecisionDate" value="@(Model.DecisionDate.HasValue?Model.DecisionDate.Value.ToString("yyyy-MM-dd"):"")"/></div>
<div class="form-group"><label class="required">Ngày xảy ra</label><input class="form-control" type="date" name="AccidentDate" value="@Model.AccidentDate.ToString("yyyy-MM-dd")"/></div>
<div class="form-group"><label class="required">Ngày thông báo</label><input class="form-control" type="date" name="NotificationDate" value="@Model.NotificationDate.ToString("yyyy-MM-dd")"/></div>
<div class="form-group"><label>Số hồ sơ</label>@Html.TextBoxFor(x=>x.ClaimNumber,new{@class="form-control readonly",@readonly="readonly",placeholder="Tự động sinh khi lưu"})</div>
<div class="form-group"><label>Mã giám định viên</label>@Html.TextBoxFor(x=>x.SurveyorCode,new{@class="form-control"})</div>
<div class="form-group"><label>Giá trị xe / tiền bảo hiểm</label>@Html.TextBoxFor(x=>x.InsuredValue,new{@class="form-control right",type="number",step="1"})</div>
</div>
<div class="summary-strip"><div>Số hồ sơ: <strong>@(string.IsNullOrWhiteSpace(Model.ClaimNumber)?"(chưa cấp)":Model.ClaimNumber)</strong></div><div>Mã giám định viên: <strong>@(string.IsNullOrWhiteSpace(Model.SurveyorCode)?"(chưa gán)":Model.SurveyorCode)</strong></div></div>
<div class="footer-actions">@if(isNew){<button class="btn" type="submit">Lưu</button>}else{<button class="btn js-next-tab" type="button">Tiếp theo</button>}</div>}
</div>
