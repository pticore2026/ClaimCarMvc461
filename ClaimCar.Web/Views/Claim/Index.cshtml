@model IList<ClaimCar.Web.Models.Claim>
@{ ViewBag.Title="Hồ sơ bồi thường xe cơ giới"; }
<div class="toolbar"><div><h1>Hồ sơ bồi thường xe cơ giới</h1><div class="muted">Tiếp nhận, quản lý và xử lý hồ sơ bồi thường xe cơ giới.</div></div><a class="btn" href="@Url.Action("Create")">+ Tạo hồ sơ</a></div>
<div class="card">
@using(Html.BeginForm("Index","Claim",FormMethod.Get)){<div class="search-bar"><input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Số hồ sơ / biển số / số hợp đồng"/><select class="form-control" name="status"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"Mới tiếp nhận","Đang giám định","Đã bảo lãnh","Đã trình duyệt","Đã duyệt","Đã chi trả","Từ chối"}){<option value="@s" @(ViewBag.Status==s?"selected":"")>@s</option>}</select><button class="btn" type="submit">Tìm kiếm</button></div>}
<table class="grid-table"><thead><tr><th>Số hồ sơ</th><th>Biển số</th><th>Số hợp đồng</th><th>Ngày xảy ra</th><th>Tình trạng</th><th>Giám định viên</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.ClaimNumber</strong></td><td>@x.LicensePlate</td><td>@x.PolicyNumber</td><td class="center">@x.AccidentDate.ToString("dd/MM/yyyy")</td><td>@x.Status</td><td>@x.SurveyorCode</td><td class="actions"><a href="@Url.Action("Edit",new{id=x.Id})">Xem / Sửa</a></td></tr>}</tbody></table>
</div>
