@model ClaimCar.Web.Models.LoginViewModel
@{ Layout=null; ViewBag.Title="Đăng nhập"; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta http-equiv="Content-Type" content="text/html; charset=utf-8"/><meta name="viewport" content="width=device-width"/><title>Đăng nhập - Bồi thường Xe</title><link rel="stylesheet" href="@Url.Content("~/Content/site.css")"/></head><body><div class="login-wrap"><div class="login-card"><h1>Bồi thường Xe</h1><p>Hệ thống tiếp nhận hồ sơ và báo giá</p>@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ReturnUrl)<div class="notice-error validation-summary-errors">@Html.ValidationSummary(true)</div><div class="form-group"><label>Tài khoản</label>@Html.TextBoxFor(x=>x.UserName,new{@class="form-control",autocomplete="username"})</div><div class="form-group" style="margin-top:14px"><label>Mật khẩu</label>@Html.PasswordFor(x=>x.Password,new{@class="form-control",autocomplete="current-password"})</div><button class="btn" style="width:100%;margin-top:20px" type="submit">Đăng nhập</button><div class="hint" style="margin-top:12px">Demo mặc định: admin / 123456. Có thể đổi trong Web.config.</div>}</div></div></body></html>
