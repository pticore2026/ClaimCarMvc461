@model ClaimCar.Web.Models.QuoteViewModel
@{ ViewBag.Title="Báo giá"; var claim=(ClaimCar.Web.Models.Claim)ViewBag.Claim; }
<div class="toolbar"><div><h1>Thẩm định giá & phương án bồi thường</h1><div class="muted">Luồng Make - Check - Validate theo đặc tả sheet bao-gia.</div></div><a class="btn btn-secondary" href="@Url.Action("Index","Claim")">Danh sách hồ sơ</a></div>
<div class="tabs"><a class="tab" href="@Url.Action("Edit","Claim",new{id=Model.ClaimId})">Thông tin chung</a><a class="tab" href="@Url.Action("Edit","LossPayment",new{claimId=Model.ClaimId})">Tổn thất / Chi trả</a><a class="tab active" href="#">Báo giá</a></div>
<div class="card">
@using(Html.BeginForm("Edit","Quote",FormMethod.Post,new{accept_charset="utf-8"})){
@Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ClaimId)
@if(!ViewData.ModelState.IsValid){<div class="notice notice-error">@Html.ValidationSummary(false)</div>}
<div class="form-grid" style="grid-template-columns:1fr 1fr 1fr 2fr"><div class="form-group"><label class="required">Kiểu duyệt</label><select class="form-control" name="ApprovalType"><option @(Model.ApprovalType=="Duyệt giá"?"selected":"")>Duyệt giá</option><option @(Model.ApprovalType=="Công nhận giá"?"selected":"")>Công nhận giá</option></select></div><div class="form-group"><label class="required">Giá trị thực tế</label>@Html.TextBoxFor(x=>x.ActualValue,new{@class="form-control readonly right",type="number"})</div><div class="form-group"><label>Ngày trình</label><input class="form-control readonly" type="date" name="SubmitDate" value="@(Model.SubmitDate.HasValue?Model.SubmitDate.Value.ToString("yyyy-MM-dd"):"")"/></div><div class="form-group"><label>Lý do giảm trừ</label>@Html.TextBoxFor(x=>x.ReductionReason,new{@class="form-control"})</div></div>
<div class="section-title"><span>Danh sách phụ tùng</span></div>
<div class="hint" style="margin-bottom:8px">◉ Xem chi tiết &nbsp;&nbsp; 🔍 Lấy báo giá</div>
<table class="grid-table"><thead><tr><th>Tên phụ tùng</th><th>Số lượng</th><th>Trình_Phương án</th><th>Trình_Loại PT</th><th>Trình_Giá PT</th><th>Trình_Sơn</th><th>Trình_Công</th><th>Trình_Tổng</th></tr></thead><tbody>@for(var i=0;i<Model.Items.Count;i++){<tr>@Html.HiddenFor(x=>x.Items[i].Id)<td>@Html.TextBoxFor(x=>x.Items[i].PartName,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.Items[i].Quantity,new{@class="form-control right",type="number"})</td><td>@Html.TextBoxFor(x=>x.Items[i].Proposal,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.Items[i].PartType,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.Items[i].PartPrice,new{@class="form-control right",type="number"})</td><td>@Html.TextBoxFor(x=>x.Items[i].PaintCost,new{@class="form-control right",type="number"})</td><td>@Html.TextBoxFor(x=>x.Items[i].LaborCost,new{@class="form-control right",type="number"})</td><td class="num">@Model.Items[i].Total.ToString("N0")</td></tr>}</tbody></table>
<div class="section-title"><span>Tính toán chi phí phụ tùng</span></div>
<div class="six-col">
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền thay thế"},{"Name","ReplacementTotal"},{"Value",Model.ReplacementTotal},{"PercentName","ReplacementDiscountPercent"},{"Percent",Model.ReplacementDiscountPercent}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền thay thế đ.biệt"},{"Name","SpecialReplacementTotal"},{"Value",Model.SpecialReplacementTotal},{"PercentName","noop1"},{"Percent",0m}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền sửa chữa"},{"Name","RepairTotal"},{"Value",Model.RepairTotal},{"PercentName","RepairDiscountPercent"},{"Percent",Model.RepairDiscountPercent}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền sơn"},{"Name","PaintTotal"},{"Value",Model.PaintTotal},{"PercentName","PaintDiscountPercent"},{"Percent",Model.PaintDiscountPercent}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền công"},{"Name","LaborTotal"},{"Value",Model.LaborTotal},{"PercentName","noop2"},{"Percent",0m}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền cẩu kéo"},{"Name","TowingTotal"},{"Value",Model.TowingTotal},{"PercentName","noop3"},{"Percent",0m}})
</div>
<div class="section-title"><span>Tính toán chi phí giảm trừ</span></div>
<div class="seven-col"><div class="form-group"><label>Khấu hao thay thế</label>@Html.TextBoxFor(x=>x.ReplacementDepreciationPercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Khấu hao đặc biệt</label>@Html.TextBoxFor(x=>x.SpecialDepreciationPercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Tỉ lệ g.trị tham gia BH</label>@Html.TextBoxFor(x=>x.ParticipationValuePercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Tỉ lệ phí tham gia</label>@Html.TextBoxFor(x=>x.ParticipationFeePercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Số vụ / Mức khấu trừ</label><div style="display:flex;gap:5px">@Html.TextBoxFor(x=>x.DeductibleCases,new{@class="form-control right",type="number"})@Html.TextBoxFor(x=>x.DeductibleAmount,new{@class="form-control readonly right",type="number"})</div></div><div class="form-group"><label>Giảm trừ bồi thường</label>@Html.TextBoxFor(x=>x.CompensationReductionPercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Chia sẻ rủi ro</label>@Html.TextBoxFor(x=>x.RiskSharingPercent,new{@class="form-control right",type="number",step="0.01"})</div></div>
<div class="section-title"><span>Tính toán tổng chi phí</span></div>
<div class="form-grid" style="grid-template-columns:1fr 1fr 3fr"><div class="form-group"><label>Tổng khách hàng phải thanh toán</label><div class="money-input">@Html.TextBoxFor(x=>x.CustomerPaymentTotal,new{@class="form-control readonly",type="number"})<span class="money-unit">VNĐ</span></div></div><div class="form-group"><label>Tổng chi phí duyệt giá</label><div class="money-input">@Html.TextBoxFor(x=>x.ApprovedTotal,new{@class="form-control readonly",type="number"})<span class="money-unit">VNĐ</span></div></div></div>
<div class="section-title"><span>Thông tin người thực hiện</span></div><div class="form-group" style="max-width:420px"><label>Checker</label>@Html.TextBoxFor(x=>x.Checker,new{@class="form-control readonly"})</div>
<div class="footer-actions"><button class="btn" type="submit">Tính lại & Lưu</button></div>}
</div>
