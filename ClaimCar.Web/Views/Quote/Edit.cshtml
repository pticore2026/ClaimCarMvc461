@model ClaimCar.Web.Models.QuoteViewModel
@{
    ViewBag.Title="Báo giá";
    var claim=(ClaimCar.Web.Models.Claim)ViewBag.Claim;
    var vehiclePolicy=ViewBag.VehiclePolicy as ClaimCar.Web.Models.VehiclePolicy;
    var proposals=new[]{
        "Thay thế có thu hồi",
        "Thay thế không thu hồi",
        "Thay thế đặc biệt có thu hồi",
        "Thay thế đặc biệt không thu hồi",
        "Sửa chữa"
    };
    var partTypes=new[]{
        "Chính hãng",
        "Hàng zin(X.xứ.Hãng)",
        "Loại 1(Xịn,OEM)",
        "Loại 2(Liên doanh)"
    };
    var repairCost=(Model.RepairTotal*(100m-Model.RepairDiscountPercent)/100m)
        +(Model.PaintTotal*(100m-Model.PaintDiscountPercent)/100m)
        +(Model.LaborTotal*(100m-Model.LaborDiscountPercent)/100m);
    var replacementAmount=Model.ReplacementTotal*(100m-Model.ReplacementDiscountPercent)/100m;
    var specialReplacementAmount=Model.SpecialReplacementTotal*(100m-Model.SpecialReplacementDiscountPercent)/100m;
    var replacementCost=replacementAmount+specialReplacementAmount;
    var depreciationCost=(replacementAmount*Model.ReplacementDepreciationPercent/100m)
        +(specialReplacementAmount*Model.SpecialDepreciationPercent/100m);
    var towingCost=Model.TowingTotal*(100m-Model.TowingDiscountPercent)/100m;
    var reductionReasons=new[]{
        "KHÔNG THÔNG BÁO NGAY CHO PTI",
        "KHÔNG GỬI THÔNG BÁO TỔN THẤT BẰNG VĂN BẢN CHO PTI TRONG 5 NGÀY",
        "LÁI XE TỰ Ý DI CHUYỂN KHỎI HIỆN TRƯỜNG",
        "KHÔNG THỰC HIỆN ĐẦY ĐỦ CÁC BIỆN PHÁP CỨU CHỮA, HẠN CHẾ THIỆT HẠI VỀ NGƯỜI VÀ TÀI SẢN",
        "KHÔNG GIỮ NGUYÊN HIỆN TRƯỜNG TAI NẠN",
        "XE VƯỢT TẠI KHU VỰC CÓ BIỂN QUY ĐỊNH CẤM VƯỢT",
        "TỰ Ý THÁO DỠ HOẶC SỬA CHỮA TÀI SẢN KHI CHƯA CÓ Ý KIẾN CHẤP THUẬN CỦA PTI",
        "KHÔNG HỢP TÁC VỚI PTI ĐỂ ĐÒI LẠI NGƯỜI THỨ BA",
        "CHỞ QUÁ SỐ NGƯỜI THEO QUY ĐỊNH (TỪ TRÊN 20%-50%)",
        "VƯỢT QUÁ TỐC ĐỘ CHO PHÉP (TỪ TRÊN 20%-50%)"
    };
}
<div class="toolbar"><div><h1>Thẩm định giá & phương án bồi thường</h1><div class="muted">Luồng Make - Check - Validate theo đặc tả sheet bao-gia.</div></div><a class="btn btn-secondary" href="@Url.Action("Index","Claim")">Danh sách hồ sơ</a></div>
<div class="tabs"><a class="tab" href="@Url.Action("Edit","Claim",new{id=Model.ClaimId})">Thông tin chung</a><a class="tab" href="@Url.Action("Edit","LossPayment",new{claimId=Model.ClaimId})">Tổn thất / Chi trả</a><a class="tab active" href="#">Báo giá</a></div>
<div class="card">
@using(Html.BeginForm("Edit","Quote",FormMethod.Post,new{accept_charset="utf-8"})){
@Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ClaimId)
if(!ViewData.ModelState.IsValid){<div class="notice notice-error">@Html.ValidationSummary(false)</div>}
<div class="form-grid" style="grid-template-columns:1fr 1fr 1fr 1fr 2fr"><div class="form-group"><label class="required">Kiểu duyệt</label><select class="form-control" name="ApprovalType"><option @(Model.ApprovalType=="Duyệt giá"?"selected":"")>Duyệt giá</option><option @(Model.ApprovalType=="Công nhận giá"?"selected":"")>Công nhận giá</option></select></div><div class="form-group"><label class="required">Giá trị thực tế tại thời điểm cấp đơn</label>@Html.TextBoxFor(x=>x.ActualValue,new{@class="form-control readonly right",type="number",@readonly="readonly"})<div class="hint">Lấy từ Giá trị xe / tiền bảo hiểm tại tab Thông tin chung</div></div><div class="form-group"><label>Số tiền bảo hiểm tham gia</label><input class="form-control readonly right" type="number" readonly value="@(vehiclePolicy==null?0:vehiclePolicy.InsuredAmount)"/><div class="hint">Lấy theo đơn bảo hiểm</div></div><div class="form-group"><label>Ngày trình</label><input class="form-control readonly" type="date" name="SubmitDate" value="@(Model.SubmitDate.HasValue?Model.SubmitDate.Value.ToString("yyyy-MM-dd"):"")"/></div><div class="form-group"><label>Lý do giảm trừ</label>@Html.DropDownListFor(x=>x.ReductionReason,new SelectList(reductionReasons,Model.ReductionReason),"-- Chọn lý do giảm trừ --",new{@class="form-control"})</div></div>
<div class="section-title"><span>Danh sách phụ tùng</span><button type="button" class="part-add-trigger" aria-label="Thêm phụ tùng" title="Thêm phụ tùng" data-vehicle-brand="@(vehiclePolicy==null?"":vehiclePolicy.Brand)" data-vehicle-version="@(vehiclePolicy==null?"":vehiclePolicy.Model)" data-vehicle-type-number="@(vehiclePolicy==null?"":vehiclePolicy.ChassisNumber)">+</button></div>
<table class="grid-table quote-parts-table"><thead><tr><th>Tên phụ tùng</th><th>Số lượng</th><th>Trình_Phương án</th><th>Trình_Loại PT</th><th>Trình_Giá PT</th><th>Trình_Sơn</th><th>Trình_Công</th><th>Trình_Tổng</th><th>Thao tác</th></tr></thead><tbody class="quote-part-rows">@for(var i=0;i<Model.Items.Count;i++){<tr><td>@Html.HiddenFor(x=>x.Items[i].Id)@Html.HiddenFor(x=>x.Items[i].PartCode)@Html.TextBoxFor(x=>x.Items[i].PartName,new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.Items[i].Quantity,new{@class="form-control right",type="number"})</td><td>@Html.HiddenFor(x=>x.Items[i].Damage)@Html.HiddenFor(x=>x.Items[i].Dimensions)@Html.DropDownListFor(x=>x.Items[i].Proposal,new SelectList(proposals,Model.Items[i].Proposal),"-- Chọn phương án --",new{@class="form-control"})</td><td>@Html.DropDownListFor(x=>x.Items[i].PartType,new SelectList(partTypes,Model.Items[i].PartType),"-- Chọn loại --",new{@class="form-control"})</td><td>@Html.TextBoxFor(x=>x.Items[i].PartPrice,new{@class="form-control right",type="number"})</td><td>@Html.TextBoxFor(x=>x.Items[i].PaintCost,new{@class="form-control right",type="number"})</td><td>@Html.TextBoxFor(x=>x.Items[i].LaborCost,new{@class="form-control right",type="number"})</td><td class="num">@Model.Items[i].Total.ToString("N0")</td><td><button type="button" class="btn btn-secondary quote-part-edit">Sửa</button> <button type="button" class="btn btn-secondary quote-part-delete">Xóa</button></td></tr>}</tbody></table>
<div class="section-title"><span>Tính toán chi phí phụ tùng</span></div>
<div class="six-col">
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền thay thế"},{"Name","ReplacementTotal"},{"Value",Model.ReplacementTotal},{"PercentName","ReplacementDiscountPercent"},{"Percent",Model.ReplacementDiscountPercent},{"Auto",true}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền thay thế đ.biệt"},{"Name","SpecialReplacementTotal"},{"Value",Model.SpecialReplacementTotal},{"PercentName","SpecialReplacementDiscountPercent"},{"Percent",Model.SpecialReplacementDiscountPercent},{"Auto",true}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền sửa chữa"},{"Name","RepairTotal"},{"Value",Model.RepairTotal},{"PercentName","RepairDiscountPercent"},{"Percent",Model.RepairDiscountPercent},{"Auto",true}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền sơn"},{"Name","PaintTotal"},{"Value",Model.PaintTotal},{"PercentName","PaintDiscountPercent"},{"Percent",Model.PaintDiscountPercent},{"Auto",true}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền công"},{"Name","LaborTotal"},{"Value",Model.LaborTotal},{"PercentName","LaborDiscountPercent"},{"Percent",Model.LaborDiscountPercent},{"Auto",true}})
@Html.Partial("_MoneyBlock",new ViewDataDictionary{{"Label","Tổng tiền cẩu kéo"},{"Name","TowingTotal"},{"Value",Model.TowingTotal},{"PercentName","TowingDiscountPercent"},{"Percent",Model.TowingDiscountPercent}})
</div>
<div class="form-group" style="max-width:360px;margin-top:14px"><label>Chi phí sửa chữa</label><div class="money-input"><input id="RepairCostTotal" class="form-control readonly right" type="text" readonly value="@repairCost.ToString("N0")"/><span class="money-unit">VNĐ</span></div><div class="hint">Tổng thành tiền sửa chữa + thành tiền sơn + thành tiền công</div></div>
<div class="form-group" style="max-width:360px;margin-top:14px"><label>Chi phí thay mới phụ tùng</label><div class="money-input"><input id="ReplacementCostTotal" class="form-control readonly right" type="text" readonly value="@replacementCost.ToString("N0")"/><span class="money-unit">VNĐ</span></div><div class="hint">Thành tiền thay thế + thành tiền thay thế đặc biệt</div></div>
<div class="form-group" style="max-width:360px;margin-top:14px"><label>Chi phí khấu hao</label><div class="money-input"><input id="DepreciationCostTotal" class="form-control readonly right" type="text" readonly value="@depreciationCost.ToString("N0")"/><span class="money-unit">VNĐ</span></div><div class="hint">Khấu hao thay thế + khấu hao thay thế đặc biệt</div></div>
<div class="form-group" style="max-width:360px;margin-top:14px"><label>Chi phí cứu hộ (cẩu kéo)</label><div class="money-input"><input id="TowingCostTotal" class="form-control readonly right" type="text" readonly value="@towingCost.ToString("N0")"/><span class="money-unit">VNĐ</span></div></div>
<div class="section-title"><span>Tính toán chi phí giảm trừ</span></div>
<div class="seven-col"><div class="form-group"><label>Khấu hao thay thế</label>@Html.TextBoxFor(x=>x.ReplacementDepreciationPercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Khấu hao đặc biệt</label>@Html.TextBoxFor(x=>x.SpecialDepreciationPercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Tỉ lệ g.trị tham gia BH</label>@Html.TextBoxFor(x=>x.ParticipationValuePercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Tỉ lệ phí tham gia</label>@Html.TextBoxFor(x=>x.ParticipationFeePercent,new{@class="form-control right",type="number",step="0.01"})</div><div class="form-group"><label>Số vụ / Số tiền khấu trừ chung</label><div style="display:flex;gap:5px">@Html.TextBoxFor(x=>x.DeductibleCases,new{@class="form-control right",type="number",min="0"})@Html.TextBoxFor(x=>x.DeductibleAmount,new{@class="form-control readonly right",type="number",@readonly="readonly"})</div><div class="hint">Mức khấu trừ theo đơn BH × số vụ</div></div><div class="form-group"><label>Tỷ lệ giảm trừ bồi thường</label>@Html.TextBoxFor(x=>x.CompensationReductionPercent,new{@class="form-control right",type="number",step="0.01",min="0",max="100"})</div><div class="form-group"><label>Số tiền giảm trừ bồi thường</label>@Html.TextBoxFor(x=>x.CompensationReductionAmount,new{@class="form-control right",type="number",min="0"})<div class="hint">Nhập số tiền để hệ thống tự quy đổi tỷ lệ</div></div><div class="form-group"><label>Tỷ lệ chia sẻ rủi ro</label>@Html.TextBoxFor(x=>x.RiskSharingPercent,new{@class="form-control right",type="number",step="0.01"})</div></div>
<div class="section-title"><span>Tính toán tổng chi phí</span></div>
<div class="form-grid" style="grid-template-columns:1fr 1fr 3fr"><div class="form-group"><label>Tổng khách hàng phải thanh toán</label><div class="money-input">@Html.TextBoxFor(x=>x.CustomerPaymentTotal,new{@class="form-control readonly",type="number",@readonly="readonly"})<span class="money-unit">VNĐ</span></div></div><div class="form-group"><label>Tổng số tiền bồi thường</label><div class="money-input">@Html.TextBoxFor(x=>x.ApprovedTotal,new{@class="form-control readonly",type="number",@readonly="readonly"})<span class="money-unit">VNĐ</span></div></div></div>
<div class="section-title"><span>Thông tin người thực hiện</span></div><div class="form-group" style="max-width:420px"><label>Checker</label>@Html.TextBoxFor(x=>x.Checker,new{@class="form-control readonly"})</div>
<div class="footer-actions"><button class="btn btn-secondary js-previous-tab" type="button">Quay lại</button><button class="btn" type="submit">Tính lại & Lưu</button></div>}
</div>
