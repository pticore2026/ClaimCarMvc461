@{ var label=(string)ViewData["Label"]; var name=(string)ViewData["Name"]; var value=(decimal)ViewData["Value"]; var pName=(string)ViewData["PercentName"]; var p=(decimal)ViewData["Percent"]; var discounted=value-(value*p/100m); var auto=ViewData["Auto"]!=null&&(bool)ViewData["Auto"]; }
<div class="money-block"><div class="form-group"><label>@label</label><div class="money-input">@if(auto){<input class="form-control readonly" type="number" name="@name" value="@value.ToString(System.Globalization.CultureInfo.InvariantCulture)" readonly/>}else{<input class="form-control" type="number" name="@name" value="@value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>}<span class="money-unit">VNĐ</span></div></div><div class="form-group"><label>Giảm giá liên kết</label><div style="display:flex"><input class="form-control right" type="number" step="0.01" name="@pName" value="@p.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><span class="money-unit">%</span></div>@Html.ValidationMessage(pName)</div><div class="form-group"><label>Thành tiền</label><div class="money-input"><input class="form-control readonly money-block-amount" readonly value="@discounted.ToString("N0")"/><span class="money-unit">VNĐ</span></div></div></div>
